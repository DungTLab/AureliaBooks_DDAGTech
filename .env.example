# Local/demo defaults are supplied by Compose; never put real secrets in Git.
# Production DB credentials are required by docker-compose.prod.yml.
MYSQL_ROOT_PASSWORD=
DB_USER=
DB_PASS=

# First production admin: enable for initial deployment, then disable/remove the password.
# Configure these in the Spring Boot process/container, not only in the MySQL container.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
